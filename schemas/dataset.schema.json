{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family dataset v1/v2",
  "type": "object",
  "required": ["schemaVersion", "people", "sources"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "events": {"type":"array","items":{"type":"object","required":["id","title","summary","status","personIds","date","citations"],"properties":{
      "id":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},"title":{"type":"string","minLength":1},"summary":{"type":"string"},
      "status":{"enum":["proposed","confirmed","conflicted"]},"personIds":{"type":"array","items":{"type":"string"}},
      "date":{"type":"object","required":["kind","text"],"properties":{"kind":{"enum":["exact","by","before","after","approximate","range","unknown"]},"text":{"type":"string"},"start":{"type":"string"},"end":{"type":"string"}}},
      "citations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/citation"}},
      "parentId":{"type":"string"},"journeyIds":{"type":"array","items":{"type":"string"}},
      "place":{"type":"object","required":["name"],"properties":{"name":{"type":"string"},"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180}}},
      "media":{"type":"array","items":{"type":"object","required":["id","url","caption"],"properties":{"id":{"type":"string"},"url":{"type":"string"},"caption":{"type":"string"}}}}
    }}},
    "families": {"type":"array","items":{"type":"object","required":["id","partners","children","events","citation"],"properties":{
      "id":{"type":"string","pattern":"^[A-Za-z0-9_.-]+$"},
      "partners":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "children":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
      "citation":{"$ref":"#/$defs/citation"},
      "events":{"type":"array","items":{"type":"object","required":["id","type","value","date","place","citation"],"properties":{
        "id":{"type":"string"},"type":{"enum":["marriage","divorce"]},"value":{"type":"string"},
        "date":{"type":["string","null"]},"place":{"type":["string","null"]},"citation":{"$ref":"#/$defs/citation"}
      }}}
    }}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "people": {"type": "array", "items": {
      "type": "object", "required": ["id", "name", "parents", "facts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "name": {"type": "string", "minLength": 1},
        "parents": {"type": "array", "items": {"type": "string"}},
        "facts": {"type": "array", "items": {
          "type": "object", "required": ["id", "type", "value", "citation"],
          "properties": {
            "id": {"type": "string"}, "type": {"type": "string"}, "value": {"type": "string"},
            "citation": {"type": "object", "required": ["sourceId", "locator"], "properties": {"sourceId": {"type": "string"}, "locator": {"type": "string"}}}
          }
        }}
      }
    }}
  },
  "$defs":{"citation":{"type":"object","required":["sourceId","locator"],"properties":{"sourceId":{"type":"string"},"locator":{"type":"string"}}}},
  "allOf":[{"if":{"properties":{"schemaVersion":{"const":2}}},"then":{"required":["families"]},"else":{"not":{"required":["families"]}}}]
}
